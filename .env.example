APP_URL=http://localhost:8080
DASHBOARD_URL=http://localhost:3000

DATABASE_URL=postgres://filebase:password@localhost:5432/filebase
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1
DATABASE_CONNECT_TIMEOUT_SECONDS=5
REDIS_URL=redis://localhost:6379

JWT_SECRET=change_me
ENCRYPTION_KEY=change_me_32_byte_key

STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads
PUBLIC_BASE_URL=http://localhost:8080/uploads

MAX_UPLOAD_SIZE=10485760
AUTH_RATE_LIMIT_PER_MINUTE=10
UPLOAD_RATE_LIMIT_PER_MINUTE=60
DEFAULT_DUPLICATE_STRATEGY=return_existing

# Resumable (chunked) uploads
UPLOAD_CHUNK_SIZE=5242880

# Video metadata and thumbnail generation (requires ffmpeg/ffprobe binaries)
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg

# Dynamic image transformations by URL
CDN_BASE_URL=
TRANSFORM_CACHE_TTL_SECONDS=86400
TRANSFORM_MAX_DIMENSION=4096
TRANSFORM_RATE_LIMIT_PER_MINUTE=240
